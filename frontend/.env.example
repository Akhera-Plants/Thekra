# API origin, no trailing slash. Local API by default (docs/build/LOCAL_DEV.md, mode A).
# To use the production API instead, run `pnpm dev:web:prod-api`, or put
# NEXT_PUBLIC_API_URL=https://thekra.vercel.app in frontend/.env.local (gitignored; delete
# it to switch back). Browser-side calls then need http://localhost:3000 in the production
# CORS_ORIGINS. Compiled into the client bundle: never put a secret here.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Public sign-in / favorites chrome. Keep false until the accounts phase; /admin still works.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
