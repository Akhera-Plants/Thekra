DATABASE_URL="postgresql://thekra:thekra_dev_password@localhost:5432/thekra?schema=public"
# Same as DATABASE_URL locally. On Neon: pooled → DATABASE_URL, direct → DIRECT_URL.
DIRECT_URL="postgresql://thekra:thekra_dev_password@localhost:5432/thekra?schema=public"
PORT=3001
# Browser origins allowed to call the API (sent with credentials), comma-separated.
# Each entry is an exact origin (scheme://host[:port], no trailing slash) or one host
# pattern with a single "*" in the leftmost label, matching [a-z0-9-]+ only, e.g.
#   https://thekra-web-*-almekdadmohammadgmailcoms-projects.vercel.app
# A bare "*", "null" or a malformed entry stops the API at boot. Default when unset:
# http://localhost:3000. Production value: docs/deploy/VERCEL.md § 3. Modes: docs/build/LOCAL_DEV.md.
CORS_ORIGINS="http://localhost:3000"
NODE_ENV=development
LOG_LEVEL=info
# Variety-mode shuffle: minimum relevanceScore to enter the md5-shuffled band (default 70)
VARIETY_SCORE_FLOOR=70
# Preferred Quran-verse provider (e.g. 'quran.com') — used when multiple providers cache the same ayah
# QURAN_PREFERRED_PROVIDER=
# D-1: Stop-gap admin key (no longer used by admin routes — kept for backwards compat).
# ADMIN_API_KEY=

# ── Phase 4: JWT auth ──────────────────────────────────────────────────────────
# REQUIRED in production (app will fail to start with defaults).
# JWT_ACCESS_SECRET=change-me-in-production
# JWT_REFRESH_SECRET=change-me-in-production-different-from-access
# Access token lifetime (vercel/ms format, e.g. 15m, 1h)
ACCESS_TTL=15m
# Refresh token lifetime (rotating; 30d recommended)
REFRESH_TTL=30d

# Show reviewed athar («من أقوال السلف»). Only rows with decision keep are public.
ATHAR_PUBLIC_ENABLED=true

# ── Web push (docs/plan/2026-10-web-push.md) ────────────────────────────────────
# Optional: push is on only when ALL of these are set; otherwise GET /v1/push/config says enabled=false.
# TEMPORARY while on Vercel Hobby (QStash timer + daily Vercel cron): docs/deploy/MIGRATION_OFF_VERCEL.md.
# VAPID keys: run `pnpm --filter backend push:keys` once; never commit them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Public base URL of this API; QStash calls <it>/v1/push/deliver.
# PUSH_PUBLIC_API_URL=https://thekra.vercel.app
# Upstash console → QStash: token and the two signing keys (QSTASH_URL only if the console shows a regional one).
# QSTASH_TOKEN=
# QSTASH_URL=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Random secret; Vercel sends it to GET /v1/push/refill (backend/vercel.json "crons").
# CRON_SECRET=

# ── One-off release commands (docs/build/RELEASE_DB.md) ───────────────────────
# Not app config: pass them on the command line, never store them in this file.
#   scripts/release-db.sh push          NEON_DATABASE_URL (Neon direct host, not -pooler)
#   scripts/release-db.sh (optional)    LOCAL_DATABASE_URL, PG_BIN, PG_CONTAINER
#   pnpm --filter backend admin:create  DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD (>= 16 chars)
